# ---------------------------------------------------------------------------
# Contrato de variáveis de ambiente.
#
# Copie para .env e ajuste conforme necessário:
#   cp .env.example .env
#
# Os valores abaixo são de DESENVOLVIMENTO LOCAL e correspondem ao que o
# docker-compose.yml sobe. Nenhum deles é segredo real — credenciais de
# verdade nunca entram no repositório. Ver README, seção "Variáveis de
# ambiente".
# ---------------------------------------------------------------------------

# --- aplicação -------------------------------------------------------------
# NODE_ENV    : development | test | production
# APP_PORT    : porta HTTP da API
# WORKER_PORT : porta do processo de worker, só para /health e /metrics
# LOG_LEVEL   : fatal | error | warn | info | debug | trace
NODE_ENV=development
APP_PORT=3000
WORKER_PORT=3001
LOG_LEVEL=info

# --- PostgreSQL ------------------------------------------------------------
# A porta 5433 evita colisão com uma instalação nativa de PostgreSQL que
# normalmente ocupa a 5432 no host. Dentro da rede do Compose o serviço
# continua escutando em 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering
POSTGRES_DB=wagering

# --- AWS SQS via MiniStack -------------------------------------------------
# Credenciais fictícias: o emulador aceita qualquer par não vazio e não as
# valida. A região é exigida pelo SDK. Ver ADR-002.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Endpoint do emulador. Apontar para a AWS real é só trocar esta linha por
# uma string vazia, deixando o SDK resolver o endpoint padrão.
SQS_ENDPOINT=http://localhost:4566
SQS_PORT=4566

# As URLs das filas são resolvidas em tempo de execução por GetQueueUrl a
# partir destes nomes — não são fixadas aqui, porque variam com a conta e a
# região.
SQS_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo

# Fila de SAÍDA dos eventos de integração, e a DLQ dela. O enunciado nomeia
# apenas a fila de entrada; publicar evento nela faria o próprio consumidor
# recebê-lo de volta. Ver ADR-012. O sufixo .fifo também é validado aqui.
SQS_EVENTS_QUEUE_NAME=wagering-events.fifo
SQS_EVENTS_DLQ_NAME=wagering-events-dlq.fifo

# Nome do consumidor, usado como chave do inbox junto ao messageId.
SQS_CONSUMER_NAME=wager-transactions-consumer

# Prazos do transporte. O default do SDK é SEM LIMITE de requisição, o que
# pendura a chamada quando o endpoint aceita a conexão e não responde.
#
# SQS_REQUEST_TIMEOUT_MS precisa tolerar a operação legítima mais lenta, que é
# um ReceiveMessage com long poll de até 20 s — abaixo de 25000 a inicialização
# recusa, porque um timeout menor que o long poll abortaria todo recebimento
# normal sem acusar erro.
SQS_REQUEST_TIMEOUT_MS=30000
SQS_CONNECTION_TIMEOUT_MS=3000

# --- consumidor e workers --------------------------------------------------
# CONSUMER_MAX_MESSAGES : mensagens por ReceiveMessage; 10 é o teto da AWS.
#
# WORKER_SHUTDOWN_TIMEOUT_MS: no SIGTERM, quanto o processo espera as
# mensagens em andamento terminarem antes de devolver a visibilidade delas.
# Precisa ser menor que o prazo entre SIGTERM e SIGKILL — no Compose, 10 s.
CONSUMER_MAX_MESSAGES=10
WORKER_SHUTDOWN_TIMEOUT_MS=8000

# Publicador da outbox. Não dorme quando o lote volta cheio: o intervalo é o
# tempo de espera quando não há mais nada vencido.
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20

# Worker de referência pendente. Mais folgado de propósito: a menor espera da
# agenda da seção 7.1 é de 11 minutos.
REFERENCE_POLL_INTERVAL_MS=5000
REFERENCE_BATCH_SIZE=20

# --- observabilidade -------------------------------------------------------
# Prazo de cada verificação do /health/ready. Curto de propósito: readiness
# responde sobre o estado atual, e dependência lenta é dependência
# indisponível para efeito de aceitar tráfego. Mantenha menor que o prazo que
# o orquestrador dá à sonda.
HEALTH_CHECK_TIMEOUT_MS=2000
